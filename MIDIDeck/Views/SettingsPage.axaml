<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MIDIDeck.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MIDIDeck.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="10">
            <!-- Заголовок -->
            <TextBlock Text="⚙️ Настройки" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Настройки приложения" Foreground="Gray"/>

            <!-- Общие настройки -->
            <Border Background="#FF2D2D30" CornerRadius="8" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Общие" FontWeight="SemiBold" FontSize="16"/>
                    
                    <CheckBox Content="Запускать при старте Windows" 
                              IsChecked="{Binding StartWithWindows}"/>
                    
                    <CheckBox Content="Сворачивать в трей" 
                              IsChecked="{Binding MinimizeToTray}"/>
                    
                    <CheckBox Content="Показывать уведомления" 
                              IsChecked="{Binding ShowNotifications}"/>
                </StackPanel>
            </Border>

            <!-- MIDI настройки -->
            <Border Background="#FF2D2D30" CornerRadius="8" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="MIDI" FontWeight="SemiBold" FontSize="16"/>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Последнее выбранное устройство (индекс):" Foreground="Gray"/>
                        <NumericUpDown Value="{Binding LastSelectedDeviceIndex}" 
                                       Minimum="-1" Maximum="100"
                                       HorizontalAlignment="Left" Width="200"/>
                        <TextBlock Text="-1 означает автовыбор первого устройства" 
                                   Foreground="Gray" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Информация -->
            <Border Background="#FF2D2D30" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="О программе" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="MIDIDeck v1.0" Foreground="Gray"/>
                    <TextBlock Text="Управление горячими клавишами через MIDI-устройство" 
                               Foreground="Gray" TextWrapping="Wrap"/>
                    <TextBlock Text="Поддерживаемые действия:" Foreground="Gray" Margin="0,10,0,0"/>
                    <TextBlock Text="• Запуск приложений" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="• Симуляция клавиш F13-F24" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="• Открытие URL" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text="• Выполнение команд" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Кнопки -->
            <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                <Button Grid.Column="0" Content="💾 Сохранить настройки" 
                        Command="{Binding SaveSettingsCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                <Button Grid.Column="1" Content="🔄 Сбросить" 
                        Command="{Binding ResetSettingsCommand}"
                        HorizontalAlignment="Stretch" Margin="5,0,0,0"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

